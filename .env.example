# --- Email account being monitored (use an app password, not your real password) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-inbox@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# --- Where routed emails get forwarded ---
HR_EMAIL=hr@example.com
MANAGER_EMAIL=manager@example.com

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# --- Discord webhooks (Server Settings -> Integrations -> Webhooks) ---
DISCORD_WEBHOOK_HR=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_MANAGER=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URGENT=https://discord.com/api/webhooks/...

# --- Logging ---
DB_PATH=email_triage.db

# --- Behavior ---
POLL_INTERVAL_SECONDS=60
RAG_CONFIDENCE_THRESHOLD=0.55
